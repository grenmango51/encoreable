{
  "name": "encoreable",
  "version": "0.1.0",
  "private": true,
  "description": "An analysis board for competitive Pokemon: restore a recorded battle to any turn and play it forward, both sides, in the real Showdown interface.",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/local-battle.mjs",
    "battle": "node scripts/local-battle.mjs",
    "replay": "node scripts/local-replay.mjs",
    "live": "node scripts/local-live.mjs",
    "serve": "node scripts/local-serve.mjs",
    "stop": "node scripts/local-stop.mjs",
    "check": "node scripts/local-check.mjs"
  },
  "dependencies": {
    "pokemon-showdown": "0.11.11"
  }
}
